# ============================================================================
# .env.example - PLANTILLA de configuración (este archivo SÍ se sube a git)
# 1) Copialo con el nombre ".env"   2) Completá tus valores reales en el .env
# El archivo ".env" real NUNCA se sube a git (está en .gitignore).
# ============================================================================

# Servidor de la base de datos MySQL
DB_HOST=localhost

# Puerto de MySQL (el de WAMP suele ser 3306)
DB_PORT=3306

# Nombre de la base de datos (la crea database/fruti_caos.sql)
DB_NAME=fruti_caos

# Usuario de MySQL
DB_USER=tu_usuario

# Contraseña de MySQL (en WAMP el usuario root suele tener la contraseña vacía)
DB_PASS=tu_contraseña

# Orígenes que pueden llamar a la API desde el navegador (CORS).
# Un origen exacto, varios separados por coma, o * para permitir todos.
# Ejemplo: http://localhost,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost

# Clave secreta para firmar los tokens de inicio de sesión (JWT). OBLIGATORIA y de al menos 32 caracteres.
# Generá una propia y no la compartas. Con WAMP/PHP en consola:  php -r "echo bin2hex(random_bytes(32));"
# Mientras tenga menos de 32 caracteres, la API responde 500 en las rutas que usan tokens.
JWT_SECRET=generar_una_clave_nueva
CORS_ORIGIN=http://localhost

# Horas de duración del token de inicio de sesión (si no se define, 8)
JWT_TTL_HORAS=8

# true = las respuestas 500 incluyen el motivo del error (solo para desarrollo). En producción: false
APP_DEBUG=false